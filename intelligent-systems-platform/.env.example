# Copiar este archivo como ".env" y completar con tus valores reales.
# NUNCA subir el .env real a un repositorio público.

LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY= "api"
DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free

LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

PLATFORM_NAME=Intelligent Systems Platform
DEFAULT_MODULE=stockhunter
