# ---------------------------------------------------------------------
# Configuración de la plataforma de Triaje Médico
# Copiá este archivo como ".env" (sin el ".example") si necesitás
# pisar algún valor por defecto. Con Ollama corriendo local, ni
# siquiera hace falta crear el .env: los defaults de config.py ya
# apuntan a http://localhost:11434.
# ---------------------------------------------------------------------

# --- Ollama (proveedor local, sin API key, sin costo) ---
# Requiere tener Ollama instalado y corriendo (`ollama serve`), y el
# modelo descargado una vez: `ollama pull gemma4:e4b`
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Modelo a usar (debe estar descargado con `ollama pull`).
# Alternativas si necesitás menos uso de RAM/GPU:
# DEFAULT_MODEL=gemma4:e2b
# DEFAULT_MODEL=gemma3n:e4b
DEFAULT_MODEL=gemma4:e4b

# --- Parámetros de generación ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# --- Plataforma ---
PLATFORM_NAME=TriageFlow Paraná
