# ---------------------------------------------------------------------
# Configuración de la plataforma de Triaje Médico
# Copiá este archivo como ".env" (sin el ".example") y completá los
# valores. El archivo ".env" real NUNCA debe subirse a git (ya está
# en .gitignore) — ahí es donde va tu API key real.
# ---------------------------------------------------------------------

# --- OpenRouter (proveedor del modelo Gemma 4) ---
# Conseguí tu key en https://openrouter.ai/keys
OPENROUTER_API_KEY=


OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo a usar. Gemma 4 26B A4B (MoE) en su tier gratuito de OpenRouter.
# Alternativas si necesitás más velocidad o calidad, comentando/descomentando:
# DEFAULT_MODEL=google/gemma-4-12b-it:free
# DEFAULT_MODEL=google/gemma-4-e4b-it:free
DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free

# --- Parámetros de generación ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# --- Plataforma ---
PLATFORM_NAME=TriageFlow Paraná
